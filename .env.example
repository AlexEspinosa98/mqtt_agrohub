# Copiar a .env y completar con los valores reales — nunca commitear .env.

# --- Broker MQTT ---
# En producción el servicio corre en el mismo servidor que Mosquitto, así que se conecta por
# localhost sin TLS (el TLS es solo para el listener público 8883 que usan los gateways).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USE_TLS=false
MQTT_USERNAME=iotunimagdalena-persister
MQTT_PASSWORD=
MQTT_CLIENT_ID=iotunimagdalena-persister

# --- Latido de nube (ver docs/TOPICS.md) ---
CLOUD_HEALTH_TOPIC=iotunimagdalena/cloud/health
CLOUD_HEALTH_INTERVAL_SECONDS=60

# --- Base de datos (Postgres vía docker-compose, ver docker-compose.yml) ---
# POSTGRES_PORT es 5434 (no 5432) para no chocar con el Postgres de backed_aluna_kunsama, que ya
# usa 5433 en el mismo servidor — ver docker-compose.yml de ese repo.
POSTGRES_DB=agrohub_mqtt
POSTGRES_USER=agrohub_mqtt
POSTGRES_PASSWORD=
POSTGRES_PORT=5434

# DATABASE_URL la usa el servicio Python (mqtt_agrohub) — debe apuntar al mismo Postgres que
# arriba, con el mismo usuario/contraseña/puerto.
DATABASE_URL=postgresql://agrohub_mqtt:CAMBIAR@localhost:5434/agrohub_mqtt

LOG_LEVEL=INFO

# --- API de administración (ver api/ y README, sección "API de administración") ---
# Generar con: openssl rand -hex 32
ADMIN_API_KEY=
API_HOST=127.0.0.1
API_PORT=8006

# Rutas reales en el servidor — la API necesita permiso de ESCRITURA de grupo sobre estos dos
# archivos, y una regla de sudoers acotada a "systemctl reload mosquitto" (ver README).
MOSQUITTO_PASSWD_FILE=/etc/mosquitto/passwd
MOSQUITTO_ACL_FILE=/etc/mosquitto/acl.conf
